# Copy to .env to override defaults. Paths should be absolute.
KANANA_IMAGE=kanana-dgx-sparks:2611
KANANA_CONTAINER=kanana-dgx-sparks
KANANA_PORT=18889
# Default data directory: $HOME/.cache/kanana-dgx-sparks
# KANANA_HOME=/absolute/path/to/kanana-data
# KANANA_MODEL_DIR=/absolute/path/to/pinned-model
KANANA_MIN_START_GIB=25
KANANA_MIN_FREE_GIB=8
KANANA_READY_TIMEOUT=300
# Keep API keys out of git. Set DECISION_API_KEY in the environment or .env.
# DECISION_API_KEY=your-own-key
